# ============================================================
# Job Listing API - Test Requests
# Use the REST Client extension in VS Code to run these.
# Run them top-to-bottom the first time to set up data.
# ============================================================

@baseUrl = http://localhost:3000


# ============================================================
# AUTH
# ============================================================

### Register an employer
POST {{baseUrl}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "employer@example.com",
  "password": "secret123",
  "name": "Acme Corp",
  "role": "employer"
}

###

### Register a job seeker
POST {{baseUrl}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "seeker3@example.com",
  "password": "secret123",
  "name": "Jane Doe",
  "role": "seeker"
}

###

# @name loginEmployer
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "employer@example.com",
  "password": "secret123"
}

###

@employerAccessToken = {{loginEmployer.response.body.data.accessToken}}
@employerRefreshToken = {{loginEmployer.response.body.data.refreshToken}}

# @name loginSeeker
POST {{baseUrl}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "seeker@example.com",
  "password": "secret123"
}

###

@seekerAccessToken = {{loginSeeker.response.body.data.accessToken}}
@seekerRefreshToken = {{loginSeeker.response.body.data.refreshToken}}

###

### Refresh access token
POST {{baseUrl}}/auth/refresh HTTP/1.1
Content-Type: application/json

{
  "refreshToken": "{{seekerRefreshToken}}"
}

###

### Logout
POST {{baseUrl}}/auth/logout HTTP/1.1
Content-Type: application/json

{
  "refreshToken": "{{seekerRefreshToken}}"
}


# ============================================================
# JOBS
# ============================================================

### List all open jobs (public, Redis cached after first call)
GET {{baseUrl}}/jobs HTTP/1.1

###

# @name createJob
POST {{baseUrl}}/jobs HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{employerAccessToken}}

{
  "title": "Senior TypeScript Engineer 3",
  "company": "Acme Corp",
  "location": "Remote",
  "type": "full-time",
  "description": "We are looking for a skilled TypeScript engineer to join our team.",
  "requirements": ["3+ years TypeScript", "Node.js experience", "REST API design"],
  "responsibilities": ["Build and maintain APIs", "Code review", "Mentor juniors"],
  "perks": ["Remote-first", "Unlimited PTO", "Home office stipend"],
  "techStack": ["TypeScript", "Node.js", "PostgreSQL", "Redis"],
  "companyInfo": {
    "website": "https://acme.example.com",
    "size": "51-200",
    "industry": "Software",
    "logoUrl": "https://acme.example.com/logo.png"
  },
  "applicationDeadline": "2026-06-01"
}

###

@jobId = {{createJob.response.body.data.id}}

###

### Get job by ID (Postgres summary + Mongo details merged, Redis cached)
GET {{baseUrl}}/jobs/{{jobId}} HTTP/1.1


# ============================================================
# APPLICATIONS
# ============================================================

###

### Apply to a job (seeker only, rate limited to 10/day)
POST {{baseUrl}}/jobs/b7185009-e25a-4b05-88b2-70af17c55df5/apply HTTP/1.1
Authorization: Bearer {{seekerAccessToken}}

###

### Get my applications
GET {{baseUrl}}/applications HTTP/1.1
Authorization: Bearer {{seekerAccessToken}}


# ============================================================
# STATS
# ============================================================

###

### Get stats (public, Redis cached for 1 minute)
GET {{baseUrl}}/stats HTTP/1.1
